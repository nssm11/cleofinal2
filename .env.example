# PostgreSQL connection string (real Postgres)
# For local dev without a system Postgres, set USE_PGLITE=1 and this may be left as-is
# or set to a pglite path. When USE_PGLITE=1, DATABASE_URL is ignored for the app.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# 32+ random bytes. Required in production.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true if behind a reverse proxy/CDN (so x-forwarded-for is trusted).
# TRUST_PROXY=false
# TRUST_PROXY_HOPS=1

# Use local file-based Postgres (PGlite) instead of a system PostgreSQL.
# Ideal for Windows / machines without Postgres installed. Data is stored in .pglite/data.
# Set to 1 to force PGlite even when DATABASE_URL is present.
# USE_PGLITE=0
# PGLITE_DIR=.pglite/data

# Comma-separated list of enabled payment methods.
# Valid options: cod, bank_transfer, gift_card. `card` is not implemented yet.
# PAYMENT_METHODS_ENABLED=cod,bank_transfer,gift_card

# Seed script passwords (development only).
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Set to 1 to allow seed against NODE_ENV=production (wipes all tables).
# ALLOW_DESTRUCTIVE_SEED=
